{
  "annotations": { "list": [] },
  "editable": true,
  "title": "Observabilidad - Microservicio EP3",
  "uid": "ep3-observability",
  "tags": ["ep3", "devops", "observabilidad"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "Disponibilidad y CI/CD",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Disponibilidad del servicio",
      "description": "1 = arriba, 0 = caído (métrica up de Prometheus)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "expr": "up{job=\"observability-service\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CAÍDO", "color": "red" }, "1": { "text": "ARRIBA", "color": "green" } } }
          ],
          "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Cobertura de pruebas (CI)",
      "description": "Empujada por el pipeline vía Pushgateway (IE3)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "expr": "ci_test_coverage_ratio * 100", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 60 }, { "color": "green", "value": 70 } ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Tiempo de despliegue (CI)",
      "description": "Duración del último build/despliegue (IE3)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [{ "expr": "ci_deployment_duration_seconds", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "stat",
      "title": "Productos en inventario",
      "description": "Métrica de negocio personalizada",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [{ "expr": "products_in_inventory", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "type": "row",
      "title": "Uso de recursos",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "Uso de CPU (proceso)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        { "expr": "process_cpu_usage{application=\"observability-service\"}", "legendFormat": "CPU proceso", "refId": "A" },
        { "expr": "system_cpu_usage", "legendFormat": "CPU sistema", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "type": "timeseries",
      "title": "Uso de memoria (Heap JVM)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\", application=\"observability-service\"})", "legendFormat": "Heap usado", "refId": "A" },
        { "expr": "sum(jvm_memory_max_bytes{area=\"heap\", application=\"observability-service\"})", "legendFormat": "Heap máximo", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "row",
      "title": "Tráfico y errores",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "type": "timeseries",
      "title": "Tasa de peticiones HTTP por código",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"observability-service\"}[1m]))", "legendFormat": "HTTP {{status}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "Errores registrados (4xx y 5xx)",
      "description": "Errores acumulados del microservicio (IE1/IE3)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum(increase(http_server_requests_seconds_count{application=\"observability-service\", status=~\"4..\"}[5m]))", "legendFormat": "Errores 4xx", "refId": "A" },
        { "expr": "sum(increase(http_server_requests_seconds_count{application=\"observability-service\", status=~\"5..\"}[5m]))", "legendFormat": "Errores 5xx", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "timeseries",
      "title": "Latencia promedio de respuesta",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_sum{application=\"observability-service\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"observability-service\"}[1m]))", "legendFormat": "Latencia media", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Productos creados (acumulado)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "products_registered_total", "legendFormat": "Total creados", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
